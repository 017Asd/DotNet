@model IEnumerable<Employee.Data.Models.Employee>

<h2>Employees</h2>

<a asp-action="Create" class="btn btn-primary">Add Employee</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Department</th>
            <th>Salary</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var emp in Model)
        {
            <tr>
                <td>@emp.Name</td>
                <td>@emp.Email</td>
                <td>@emp.Department</td>
                <td>@emp.Salary</td>
            </tr>
        }
    </tbody>
</table>