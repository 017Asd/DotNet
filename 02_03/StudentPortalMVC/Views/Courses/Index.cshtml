@model IEnumerable<StudentPortalMVC.Models.Course>

<table class="table table-dark table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Duration</th>
            <th>Fee</th>
            <th>Level</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.DurationDays days</td>
            <td>@item.Fee</td>
            <td>@item.Level</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.CourseId"
                   class="btn btn-secondary btn-sm">View</a>

                <a asp-action="Edit" asp-route-id="@item.CourseId"
                   class="btn btn-outline-light btn-sm">Edit</a>

                <a asp-action="Delete" asp-route-id="@item.CourseId"
                   class="btn btn-outline-danger btn-sm">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>