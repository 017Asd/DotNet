@model IEnumerable<StudentPortalMVC.Models.Student>

@{
    ViewData["Title"] = "Students";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-light">Students</h2>
        <a asp-action="Create" class="btn btn-primary">+ Add Student</a>
    </div>

    <input type="text"
           id="studentSearch"
           placeholder="Search students..."
           class="form-control mb-3" />

    <div id="studentsTable">
        @await Html.PartialAsync("_StudentsTable", Model)
    </div>

</div>

@section Scripts{
<script>
$(document).ready(function () {

    $("#studentSearch").on("keyup", function () {

        var value = $(this).val();

        $.ajax({
            url: '/Students/Search',
            type: 'GET',
            data: { term: value },
            success: function (result) {
                $("#studentsTable").html(result);
            }
        });

    });

});
</script>
}