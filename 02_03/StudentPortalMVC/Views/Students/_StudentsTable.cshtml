@model IEnumerable<StudentPortalMVC.Models.Student>

<table class="table table-striped table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Status</th>
            <th>Join Date</th>
            <th style="width:200px;">Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.FullName</td>
            <td>@item.Email</td>
            <td>
                <span class="badge @(item.Status == "Active" ? "bg-success" : "bg-secondary")">
                    @item.Status
                </span>
            </td>
            <td>@item.JoinDate.ToShortDateString()</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.StudentId" class="btn btn-info btn-sm">View</a>
                <a asp-action="Edit" asp-route-id="@item.StudentId" class="btn btn-warning btn-sm">Edit</a>
                <a asp-action="Delete" asp-route-id="@item.StudentId" class="btn btn-danger btn-sm">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>