@model StudentPortalMVC.Models.Student

@{
    ViewData["Title"] = "Create Student";
}

<div class="container d-flex justify-content-center mt-5">

    <div class="card bg-dark text-light shadow-lg p-4 rounded-4" style="width: 600px;">

        <h2 class="mb-4 text-center">Create Student</h2>

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName"
                       class="form-control bg-secondary text-light border-0 rounded-3" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email"
                       type="email"
                       class="form-control bg-secondary text-light border-0 rounded-3" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone"
                       type="tel"
                       maxlength="10"
                       class="form-control bg-secondary text-light border-0 rounded-3"
                       id="phoneInput" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status"
                        class="form-select bg-secondary text-light border-0 rounded-3">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="JoinDate" class="form-label"></label>
                <input asp-for="JoinDate"
                       type="date"
                       class="form-control bg-secondary text-light border-0 rounded-3" />
                <span asp-validation-for="JoinDate" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-light px-4">Cancel</a>

                <button type="submit" class="btn btn-warning px-4 fw-bold">
                    Save
                </button>
            </div>

        </form>

    </div>

</div>


@section Scripts {

    <script>

        // Allow only numbers in phone field
        document.getElementById("phoneInput").addEventListener("input", function () {

            this.value = this.value.replace(/[^0-9]/g, "");

        });

    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}