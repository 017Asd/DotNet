@model StudentPortalMVC.Models.Enrollment

@{
    ViewData["Title"] = "Create Enrollment";
}

<div class="container d-flex justify-content-center mt-5">

    <div class="card bg-dark text-light shadow-lg p-4 rounded-4" style="width: 650px;">

        <h2 class="mb-4 text-center">Create Enrollment</h2>

        <!-- FIXED FORM -->
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="StudentId" class="form-label"></label>
                <select asp-for="StudentId"
                        asp-items="ViewBag.StudentId"
                        class="form-select bg-secondary text-light border-0 rounded-3">
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="CourseId" class="form-label"></label>
                <select asp-for="CourseId"
                        asp-items="ViewBag.CourseId"
                        class="form-select bg-secondary text-light border-0 rounded-3">
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="EnrollDate" class="form-label"></label>
                <input asp-for="EnrollDate"
                       type="date"
                       class="form-control bg-secondary text-light border-0 rounded-3" />
            </div>

            <div class="mb-4">
                <label asp-for="PaidAmount" class="form-label"></label>
                <input asp-for="PaidAmount"
                       type="number"
                       step="0.01"
                       class="form-control bg-secondary text-light border-0 rounded-3" />
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-light px-4">
                    Cancel
                </a>
                <button type="submit" class="btn btn-warning px-4 fw-bold">
                    Save
                </button>
            </div>

        </form>

    </div>

</div>